# ==============================================================================
# LangChain Agent Evaluation System - Environment Configuration
# ==============================================================================

# Ollama / Ollama Cloud Configuration (Default: 100% Deterministic & Local/Cloud-proxied)
# Run `ollama list` to verify model availability. Proxied via local daemon at port 11434.
OLLAMA_MODEL="gemma4:31b-cloud"
OLLAMA_BASE_URL="http://localhost:11434"

# Optional Cloud Model Fallbacks (if swapping evaluation judges)
# OPENAI_API_KEY="your-openai-api-key"
# OPENROUTER_API_KEY="your-openrouter-api-key"
